# ==============================================================================
# NexGenTech Academy - Environment Variables Configuration
# ==============================================================================

# Database Connection (Neon PostgreSQL / Local SQLite)
DATABASE_URL="file:./prisma/dev.db"

# JWT Secret for Secure Authentication
JWT_SECRET="your-super-secret-jwt-token-key-change-this-in-production"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gemini LLM AI Counselor Configuration
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_MODEL="gemini-3.6-flash"

# ChromaDB / RAG Knowledge Base Configuration
CHROMA_HOST="localhost"
CHROMA_PORT="8000"
CHROMA_COLLECTION="nexgentech_institute_knowledge"
CHROMA_URL="http://localhost:8000"

# RAG Retrieval Parameters
RAG_TOP_K="5"
RAG_SIMILARITY_THRESHOLD="0.55"
GEMINI_EMBEDDING_MODEL="models/gemini-embedding-001"

# Development Debug Mode (Set to true to enable server-side RAG intent logging)
RAG_DEBUG="false"
