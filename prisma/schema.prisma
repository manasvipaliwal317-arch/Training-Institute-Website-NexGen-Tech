// Prisma schema for Enterprise IT Training Academy Website
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String   
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model CourseCategory {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  icon        String   @default("BookOpen")
  courses     Course[]
  createdAt   DateTime @default(now())

  @@index([slug])
}

model Course {
  id               String         @id @default(uuid())
  slug             String         @unique
  title            String
  tagline          String
  description      String
  categoryId       String
  category         CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  trainerId        String?
  trainer          Trainer?       @relation(fields: [trainerId], references: [id])
  level            String         @default("All Levels") // Beginner, Intermediate, Advanced
  mode             String         @default("Hybrid") // Online, Offline, Hybrid
  duration         String   
  hoursCount       Int            @default(120)
  fees             Int      
  originalFees     Int      
  heroImage        String
  featured         Boolean        @default(false)
  bestseller       Boolean        @default(false)
  rating           Float          @default(4.9)
  ratingsCount     Int            @default(1400)
  enrolledStudents Int            @default(3200)

  syllabusJson    String   
  toolsJson       String   
  projectsJson    String   
  careerRolesJson String   
  faqsJson        String   

  batches         Batch[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([slug])
  @@index([categoryId])
}

model Batch {
  id             String   @id @default(uuid())
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startDate      String   
  timing         String   
  mode           String   
  seatsTotal     Int      @default(20)
  seatsAvailable Int      @default(5)
  status         String   @default("Filling Fast")
  campusLocation String   @default("Main Campus - Tech Park HQ")
  createdAt      DateTime @default(now())

  @@index([courseId])
}

model Trainer {
  id             String   @id @default(uuid())
  name           String
  role           String
  bio            String
  photo          String
  experienceYrs  Int
  formerCompany  String
  specialization String
  rating         Float    @default(4.9)
  courses        Course[]
  createdAt      DateTime @default(now())
}

model Testimonial {
  id              String   @id @default(uuid())
  studentName     String
  courseName      String
  previousRole    String
  currentRole     String
  company         String
  salaryHike      String   
  photo           String
  quote           String
  rating          Int      @default(5)
  createdAt       DateTime @default(now())
}

model PlacementPartner {
  id          String   @id @default(uuid())
  name        String
  logo        String
  category    String   @default("MNC Tech")
  highestPkg  String   @default("18.0 LPA")
  placedCount Int      @default(120)
  createdAt   DateTime @default(now())
}

model Placement {
  id           String   @id @default(uuid())
  studentName  String
  courseTaken  String
  roleAssigned String
  companyName  String
  companyLogo  String
  studentPhoto String
  packageLpa   String   
  year         Int      @default(2026)
  createdAt    DateTime @default(now())
}

model Inquiry {
  id              String   @id @default(uuid())
  name            String
  email           String
  phone           String
  courseSlug      String?
  courseName      String?
  preferredMode   String   @default("Hybrid")
  preferredCampus String   @default("Main Tech Park HQ")
  message         String?
  source          String   @default("Website Form")
  status          String   @default("NEW") // NEW, CONTACTED, ENROLLED, CLOSED
  createdAt       DateTime @default(now())

  @@index([status])
}

model Event {
  id                 String              @id @default(uuid())
  slug               String              @unique
  title              String
  tagline            String
  description        String
  bannerImage        String
  eventDate          String
  eventTime          String
  venue              String
  mode               String              @default("Live Online") // Live Online, In-Person, Hybrid
  speakerName        String
  speakerRole        String
  speakerPhoto       String
  speakerBio         String
  isPastEvent        Boolean             @default(false)
  category           String              @default("Masterclass") // Masterclass, Workshop, Hackathon
  registrationsCount Int                 @default(350)
  galleryJson        String              @default("[]")
  registrations      EventRegistration[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([slug])
}

model EventRegistration {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventTitle String
  name       String
  email      String
  phone      String
  createdAt  DateTime @default(now())

  @@index([eventId])
}

model Campus {
  id           String   @id @default(uuid())
  slug         String   @unique
  name         String
  type         String   @default("Regional Branch") // Headquarters, Regional Branch, Innovation Hub
  address      String
  city         String
  phone        String
  email        String
  workingHours String   @default("Mon - Sun: 8:00 AM - 9:00 PM")
  landmarks    String
  mapEmbedUrl  String
  coverImage   String
  galleryJson  String   @default("[]")
  isMain       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([slug])
}

model BlogCategory {
  id          String     @id @default(uuid())
  slug        String     @unique
  name        String
  description String
  posts       BlogPost[]
  createdAt   DateTime   @default(now())

  @@index([slug])
}

model BlogPost {
  id            String        @id @default(uuid())
  slug          String        @unique
  title         String
  excerpt       String
  content       String   
  categoryId    String?
  blogCategory  BlogCategory? @relation(fields: [categoryId], references: [id])
  category      String        // AI, Programming, Cyber Security, Cloud, Testing, Career Guidance, Digital Marketing
  featuredImage String
  authorName    String
  authorRole    String
  authorPhoto   String
  readTime      String        @default("5 min read")
  tagsJson      String        @default("[]")
  isFeatured    Boolean       @default(false)
  publishedAt   DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([slug])
  @@index([category])
}

model GalleryImage {
  id        String   @id @default(uuid())
  title     String
  category  String   @default("Campus & Labs") // Campus & Labs, Events, Classroom, Hackathons
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
}
